SECRET_KEY=replace-with-a-long-random-secret

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Set to 1 when serving through HTTPS.
SESSION_COOKIE_SECURE=0
# Set to the public HTTPS address when deployed.
PUBLIC_BASE_URL=http://localhost:5000
# Optional comma-separated alternate hosts redirected to the HTTPS PUBLIC_BASE_URL origin.
REDIRECT_FROM_HOSTS=
# Leave DATABASE_URL empty to use the local SQLite database.
DATABASE_URL=
# Set these in Azure to use private Blob Storage with the app's managed identity.
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=product-images
# Experimental: keep disabled until end-to-end testing and operational review.
BALANCE_COLLECTION_ENABLED=0
# Production single-container supervisor; keep off when using the Compose worker.
BALANCE_WORKER_IN_WEB=0

# Configure the EmailJS template with to_email, email_subject, and email_message.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
